# Mallitiedosto: ei asenna mitaan. Asennus README.md:n osion "Rinnakkaiset kaistat" mukaan. Instanssi (%i) = kaista 1..3.
# Kaistojen maara tulee yhdesta asetuksesta: CLAUDEJONO_KAISTOJA (alla). Ylaraja koodissa on 3.
[Unit]
Description=Claude-jono kaista %i: yksi tehtava docs-repon claude-jono/-kansiosta
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Ajuri on root (git, deploy key, Telegram). Agentti ajetaan kayttajana claudejono (runuser), ks. asenna-kayttaja.sh (Tonyn paatos 30.10.2026).
WorkingDirectory=/opt/agentti-pohja
Environment=CLAUDEJONO_REPO=/var/lib/claude-jono/docs
Environment=CLAUDEJONO_TYOHAK=/opt/agentscope
Environment=CLAUDEJONO_KAISTOJA=2
Environment=CLAUDEJONO_KAYTTAJA=claudejono
Environment=CLAUDEJONO_CLAUDE=/var/lib/claudejono/.local/bin/claude
# Testattu CT115:ssa 30.10.2026: auto-tila toimii headless-ajossa ilman lupakyselya
Environment=CLAUDEJONO_LUPATILA=auto
Environment="GIT_SSH_COMMAND=ssh -i /etc/claude-jono/deploy_key -o IdentitiesOnly=yes"
EnvironmentFile=-/etc/yojono/telegram.env
# Tonyn kirjoittama, ei repossa: CLAUDEJONO_LITELLM_KEY=... (OpenRouter-reitti, vain ajurille; agentti ei nae sita). Katso README, Mallien tyonjako.
EnvironmentFile=-/etc/claude-jono/litellm.env
# Yksi asetustiedosto (valinnainen): CLAUDEJONO_AGENTTIEN_OSUUS_PROS=60, CLAUDEJONO_RAJA_TAUKO_S=3600
EnvironmentFile=-/etc/claude-jono/asetukset.env
ExecStart=/usr/bin/python3 -B -m claudejono ajo --kaista %i
TimeoutStartSec=3600
# Ei NoNewPrivileges: agentin ainoa sudo-oikeus (claudejono-pr prbottina) tarvitsee sen.
PrivateTmp=true
