# Eristettyjen agenttien ajuri (kontti 122). Kopioi: /etc/systemd/system/aivo-agentit.service. Ohje: docs/aivo-agentit.md
# --roolit: sama avoin malli kuin chatissa (lista AVOIMET_MALLIT, aivo/openrouter_zdr.py). Tarkista polut ohjeen kohdasta 4.
[Unit]
Description=Aivo: eristetyt agentit (jono, yksi tehtava kerrallaan)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aivo-agentti
Group=aivo-agentti
SupplementaryGroups=aivo-agentit aivo-kulut
WorkingDirectory=/opt/agentti-pohja
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/opt/agentti-pohja
ExecStart=/usr/bin/python3 -m aivo.agentti_ajuri palvelu --perus /var/lib/aivo-agentit --roolit qwen/qwen3-235b-a22b-2507
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
CapabilityBoundingSet=
# Kirjoitus vain omaan kansioon ja kolmeen kulukirjanpidon tiedostoon. openrouter_kulut vaatii kirjoitettavan kansion,
# joten palvelu nakee kulukansion paikalla oman tilapaisen tmpfs:n, johon on liitetty vain kolme kulutiedostoa.
# Oikeaan kansioon /var/lib/claude-jono ja sen muihin tiedostoihin palvelu ei paase. Kulutiedostoja ei saa korvata
# uusilla (rename) palvelun ollessa kaynnissa: liitos pysyy vanhassa tiedostossa (ohje kohta 7).
ReadWritePaths=/var/lib/aivo-agentit
# mode=0777 ilman sticky-bittia: sticky-kansiossa fs.protected_regular estaa O_CREAT-avauksen vieraan kayttajan
# tiedostoon (kulukirjanpidon lukko ja rivit), mika esti kaikki kutsut 25.11.2026. Kansio on palvelun oma tmpfs.
TemporaryFileSystem=/var/lib/claude-jono:mode=0777,size=1M
BindPaths=/var/lib/claude-jono/openrouter-kulut.jsonl /var/lib/claude-jono/openrouter-katto.jsonl /var/lib/claude-jono/openrouter-kulut.lock
# Toinen lukko tiedosto-oikeuksien lisaksi: muisti, keskustelut, ydinohjeet ja tyokalutila eivat nay.
InaccessiblePaths=-/var/lib/aivo-yksityinen -/var/lib/aivo -/var/lib/aivo-tyokalu
MemoryMax=512M
CPUQuota=50%
TasksMax=32

[Install]
WantedBy=multi-user.target
